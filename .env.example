# Copy to .env and fill in. docker-compose.dev.yml has working defaults for
# everything here, so a local dev run needs none of it.

# Required in production. Stored NATS credentials are encrypted with this key.
# Generate one:
#   uv run python -c "from nats_lens.crypto import generate_key; print(generate_key())"
NATS_LENS_SECRET_KEY=

# SQLite. Four slashes means an absolute path, three means relative to the cwd.
DATABASE_URL=sqlite+aiosqlite:///./data/nats-lens.db

NATS_LENS_HOST=0.0.0.0
NATS_LENS_PORT=8000
NATS_LENS_DEBUG=false

# Only needed in dev, where Vite serves the SPA from a different origin.
NATS_LENS_CORS_ORIGINS=http://localhost:5173

# Set by the production image; leave unset in dev so Vite serves the SPA.
# NATS_LENS_STATIC_DIR=/srv/static

NATS_LENS_MONITOR_TIMEOUT=5.0
NATS_LENS_CONNECT_TIMEOUT=5.0
NATS_LENS_WS_QUEUE_SIZE=2048

# nats-lens keeps its NATS connections in-process. More than one worker would
# serve an inconsistent view, so the app refuses to start with a higher value.
WEB_CONCURRENCY=1
